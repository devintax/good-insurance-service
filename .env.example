# GIA Quote Capture - Local Development
# Copy this file to .env and fill in real values before running.

NODE_ENV=development
PORT=3005
ALLOWED_ORIGIN=http://localhost:5173
ADMIN_API_KEY=replace-with-a-strong-admin-key

# InsForge PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=replace-with-postgres-password
PG_DATABASE=insforge
# PGSSL=false

# ERPNext CRM
ERPNEXT_BASE_URL=https://erpnext.example.com
# Existing deployments may use ERPNEXT_URL instead of ERPNEXT_BASE_URL.
# ERPNEXT_URL=https://erpnext.example.com
ERPNEXT_API_KEY=replace-with-erpnext-api-key
ERPNEXT_API_SECRET=replace-with-erpnext-api-secret
ERPNEXT_LEAD_OWNER=

# Vite bakes this into the frontend bundle at build time.
VITE_API_URL=
